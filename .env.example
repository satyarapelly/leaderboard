# Supabase — get these from your project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Server-only (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Server/tooling only. Never prefix this with NEXT_PUBLIC_.
# Use the direct connection on persistent/IPv6-capable servers; use the
# Supabase pooler connection for serverless or IPv4-only environments.
DATABASE_URL=postgresql://postgres:YOUR_URL_ENCODED_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
